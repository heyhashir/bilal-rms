{
  "name": "bilal-rms-desktop",
  "private": true,
  "version": "0.2.4",
  "description": "Bilal RMS Windows POS desktop runtime",
  "author": "Bilal RMS",
  "main": "src/main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test:live": "node src/tests/live-connectivity.smoke.mjs",
    "dist": "node scripts/build-windows.mjs",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bilalrms.pos",
    "productName": "Bilal RMS POS",
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/public",
        "to": "public"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "BilalRMS-Setup-${version}.${ext}"
    }
  }
}
