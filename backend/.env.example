# ==============================================================================
# Bilal RMS - Production Environment Configuration Template
# Copy this file to .env (or backend/.env) on your production server (e.g. Hostinger / VPS)
# ==============================================================================

# Database Connection (MySQL / MariaDB on your live hosting server)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://bilal_db_user:YOUR_STRONG_DB_PASSWORD@localhost:3306/bilal_rms"

# Environment & Live Store URL
NODE_ENV="production"
PORT=3000
APP_URL="https://your-domain.com"

# Initial Admin Credentials (used only during initial seed / first bootstrap)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"

# Optional Session & Upload Limits
SESSION_COOKIE_NAME="bilal_rms_session"
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=10
